alias ds := python-datascience
alias py-up := upgrade-python
alias node-up := upgrade-node
alias ds-up := upgrade-python-datascience

upgrade-python:
    uv python install 3 -U --default

upgrade-node:
    fnm install --lts --use

activate-python-datascience *args:
    ~/DataScience/.venv/bin/python {{args}}

upgrade-python-datascience: upgrade-python
    uv venv .ds-venv --clear
    uv pip sync ~/.requirements
